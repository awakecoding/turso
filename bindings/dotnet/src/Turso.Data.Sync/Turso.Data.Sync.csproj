<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TursoTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Turso.Data.Sync</RootNamespace>

    <PackageId>Turso.Data.Sqlite.Sync</PackageId>
    <Title>Turso embedded replica companion</Title>
    <Description>Optional native embedded-replica and explicit Sync companion for TursoConnection, with desktop and mobile runtime assets.</Description>
    <Authors>Turso authors</Authors>
    <PackageTags>turso;sqlite;database;sync;replica;native;interop</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tursodatabase/turso</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tursodatabase/turso</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CA2255</NoWarn>
    <RequireNativeAssetsForPack>true</RequireNativeAssetsForPack>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Turso.Data\Turso.Data.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Turso.Data.Sqlite\Turso.Data.Sqlite.csproj" />
    <None Include="..\..\Readme.md" Pack="true" PackagePath="README.md" />
    <None Include="buildTransitive\Turso.Data.Sqlite.Sync.targets"
          Pack="true"
          PackagePath="buildTransitive\Turso.Data.Sqlite.Sync.targets" />
  </ItemGroup>

  <PropertyGroup>
    <TursoSyncNativeProfile Condition="'$(Configuration)'=='Debug'">debug</TursoSyncNativeProfile>
    <TursoSyncNativeProfile
      Condition="'$(Configuration)'=='Release' and Exists('..\..\rs_compiled\x86_64-pc-windows-msvc\release-official\turso_sync_sdk_kit.dll')">release-official</TursoSyncNativeProfile>
    <TursoSyncNativeProfile
      Condition="'$(Configuration)'=='Release' and '$(TursoSyncNativeProfile)'==''">release</TursoSyncNativeProfile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\rs_compiled\x86_64-pc-windows-msvc\$(TursoSyncNativeProfile)\turso_sync_sdk_kit.dll"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\x86_64-pc-windows-msvc\$(TursoSyncNativeProfile)\turso_sync_sdk_kit.dll')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>runtimes\win-x64\native\turso_sync_sdk_kit.dll</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\win-x64\native\turso_sync_sdk_kit.dll</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\aarch64-pc-windows-msvc\$(TursoSyncNativeProfile)\turso_sync_sdk_kit.dll"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\aarch64-pc-windows-msvc\$(TursoSyncNativeProfile)\turso_sync_sdk_kit.dll')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>runtimes\win-arm64\native\turso_sync_sdk_kit.dll</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\win-arm64\native\turso_sync_sdk_kit.dll</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\x86_64-unknown-linux-gnu\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\x86_64-unknown-linux-gnu\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>runtimes\linux-x64\native\libturso_sync_sdk_kit.so</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\linux-x64\native\libturso_sync_sdk_kit.so</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\aarch64-unknown-linux-gnu\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\aarch64-unknown-linux-gnu\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>runtimes\linux-arm64\native\libturso_sync_sdk_kit.so</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\linux-arm64\native\libturso_sync_sdk_kit.so</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\aarch64-linux-android\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\aarch64-linux-android\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>runtimes\android-arm64\native\libturso_sync_sdk_kit.so</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\android-arm64\native\libturso_sync_sdk_kit.so</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\armv7-linux-androideabi\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\armv7-linux-androideabi\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>runtimes\android-arm\native\libturso_sync_sdk_kit.so</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\android-arm\native\libturso_sync_sdk_kit.so</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\x86_64-linux-android\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\x86_64-linux-android\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>runtimes\android-x64\native\libturso_sync_sdk_kit.so</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\android-x64\native\libturso_sync_sdk_kit.so</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\i686-linux-android\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\i686-linux-android\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.so')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>runtimes\android-x86\native\libturso_sync_sdk_kit.so</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\android-x86\native\libturso_sync_sdk_kit.so</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\x86_64-apple-darwin\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.dylib"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\x86_64-apple-darwin\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.dylib')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>runtimes\osx-x64\native\libturso_sync_sdk_kit.dylib</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\osx-x64\native\libturso_sync_sdk_kit.dylib</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\aarch64-apple-darwin\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.dylib"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\aarch64-apple-darwin\$(TursoSyncNativeProfile)\libturso_sync_sdk_kit.dylib')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>runtimes\osx-arm64\native\libturso_sync_sdk_kit.dylib</TargetPath>
      <Pack>true</Pack>
      <PackagePath>runtimes\osx-arm64\native\libturso_sync_sdk_kit.dylib</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\Info.plist"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\Info.plist')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes/ios-universal/native/libturso_sync_sdk_kit.xcframework/</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\ios-arm64\libturso_sync_sdk_kit.framework\Info.plist"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\ios-arm64\libturso_sync_sdk_kit.framework\Info.plist')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes/ios-universal/native/libturso_sync_sdk_kit.xcframework/ios-arm64/libturso_sync_sdk_kit.framework/</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\ios-arm64\libturso_sync_sdk_kit.framework\libturso_sync_sdk_kit"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\ios-arm64\libturso_sync_sdk_kit.framework\libturso_sync_sdk_kit')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes/ios-universal/native/libturso_sync_sdk_kit.xcframework/ios-arm64/libturso_sync_sdk_kit.framework/</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\ios-arm64_x86_64-simulator\libturso_sync_sdk_kit.framework\Info.plist"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\ios-arm64_x86_64-simulator\libturso_sync_sdk_kit.framework\Info.plist')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes/ios-universal/native/libturso_sync_sdk_kit.xcframework/ios-arm64_x86_64-simulator/libturso_sync_sdk_kit.framework/</PackagePath>
    </None>
    <None Include="..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\ios-arm64_x86_64-simulator\libturso_sync_sdk_kit.framework\libturso_sync_sdk_kit"
          Visible="false"
          Condition="Exists('..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\ios-arm64_x86_64-simulator\libturso_sync_sdk_kit.framework\libturso_sync_sdk_kit')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes/ios-universal/native/libturso_sync_sdk_kit.xcframework/ios-arm64_x86_64-simulator/libturso_sync_sdk_kit.framework/</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="ValidateSyncNativeAssetsForPack" BeforeTargets="Pack"
          Condition="'$(Configuration)'=='Release' and '$(RequireNativeAssetsForPack)'=='true'">
    <Error Condition="!Exists('..\..\rs_compiled\x86_64-pc-windows-msvc\release\turso_sync_sdk_kit.dll') and !Exists('..\..\rs_compiled\x86_64-pc-windows-msvc\release-official\turso_sync_sdk_kit.dll')"
           Text="Missing win-x64 sync native asset. Build turso_sync_sdk_kit before packing Turso.Data.Sqlite.Sync." />
    <Error Condition="!Exists('..\..\rs_compiled\aarch64-pc-windows-msvc\release\turso_sync_sdk_kit.dll') and !Exists('..\..\rs_compiled\aarch64-pc-windows-msvc\release-official\turso_sync_sdk_kit.dll')"
           Text="Missing win-arm64 sync native asset. Build turso_sync_sdk_kit before packing Turso.Data.Sqlite.Sync." />
    <Error Condition="!Exists('..\..\rs_compiled\x86_64-unknown-linux-gnu\release\libturso_sync_sdk_kit.so') and !Exists('..\..\rs_compiled\x86_64-unknown-linux-gnu\release-official\libturso_sync_sdk_kit.so')"
           Text="Missing linux-x64 sync native asset. Build turso_sync_sdk_kit before packing Turso.Data.Sqlite.Sync." />
    <Error Condition="!Exists('..\..\rs_compiled\aarch64-unknown-linux-gnu\release\libturso_sync_sdk_kit.so') and !Exists('..\..\rs_compiled\aarch64-unknown-linux-gnu\release-official\libturso_sync_sdk_kit.so')"
           Text="Missing linux-arm64 sync native asset. Build turso_sync_sdk_kit before packing Turso.Data.Sqlite.Sync." />
    <Error Condition="!Exists('..\..\rs_compiled\aarch64-linux-android\release\libturso_sync_sdk_kit.so') and !Exists('..\..\rs_compiled\aarch64-linux-android\release-official\libturso_sync_sdk_kit.so')"
           Text="Missing android-arm64 sync native asset. Build turso_sync_sdk_kit before packing Turso.Data.Sqlite.Sync." />
    <Error Condition="!Exists('..\..\rs_compiled\armv7-linux-androideabi\release\libturso_sync_sdk_kit.so') and !Exists('..\..\rs_compiled\armv7-linux-androideabi\release-official\libturso_sync_sdk_kit.so')"
           Text="Missing android-arm sync native asset. Build turso_sync_sdk_kit before packing Turso.Data.Sqlite.Sync." />
    <Error Condition="!Exists('..\..\rs_compiled\x86_64-linux-android\release\libturso_sync_sdk_kit.so') and !Exists('..\..\rs_compiled\x86_64-linux-android\release-official\libturso_sync_sdk_kit.so')"
           Text="Missing android-x64 sync native asset. Build turso_sync_sdk_kit before packing Turso.Data.Sqlite.Sync." />
    <Error Condition="!Exists('..\..\rs_compiled\i686-linux-android\release\libturso_sync_sdk_kit.so') and !Exists('..\..\rs_compiled\i686-linux-android\release-official\libturso_sync_sdk_kit.so')"
           Text="Missing android-x86 sync native asset. Build turso_sync_sdk_kit before packing Turso.Data.Sqlite.Sync." />
    <Error Condition="!Exists('..\..\rs_compiled\x86_64-apple-darwin\release\libturso_sync_sdk_kit.dylib') and !Exists('..\..\rs_compiled\x86_64-apple-darwin\release-official\libturso_sync_sdk_kit.dylib')"
           Text="Missing osx-x64 sync native asset. Build turso_sync_sdk_kit before packing Turso.Data.Sqlite.Sync." />
    <Error Condition="!Exists('..\..\rs_compiled\aarch64-apple-darwin\release\libturso_sync_sdk_kit.dylib') and !Exists('..\..\rs_compiled\aarch64-apple-darwin\release-official\libturso_sync_sdk_kit.dylib')"
           Text="Missing osx-arm64 sync native asset. Build turso_sync_sdk_kit before packing Turso.Data.Sqlite.Sync." />
    <Error Condition="!Exists('..\..\rs_compiled\ios-sync-universal\native\libturso_sync_sdk_kit.xcframework\Info.plist')"
           Text="Missing iOS sync framework asset. Build libturso_sync_sdk_kit.xcframework before packing Turso.Data.Sqlite.Sync." />
  </Target>
</Project>
